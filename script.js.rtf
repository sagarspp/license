\f0\fs24 \cf0 // Learners and Drivers Permit Questions\
const learnersQuestions = [\
  \{\
    question_text: "A Learner's Permit allows you to drive alone without supervision.",\
    correct_answer: "False"\
  \},\
  \{\
    question_text: "When driving with a Learner's Permit, you must have a licensed adult in the car.",\
    correct_answer: "True"\
  \},\
  \{\
    question_text: "You can drive at night with a Learner's Permit in all states.",\
    correct_answer: "False"\
  \},\
  \{\
    question_text: "It is illegal to drive with a Learner's Permit if you have been drinking alcohol.",\
    correct_answer: "True"\
  \},\
  \{\
    question_text: "A Learner's Permit restricts driving to certain hours in some states.",\
    correct_answer: "True"\
  \}\
];\
\
const driversQuestions = [\
  \{\
    question_text: "A Driver's Permit allows you to drive without restrictions.",\
    correct_answer: "False"\
  \},\
  \{\
    question_text: "A Driver's Permit allows you to drive alone after passing a road test.",\
    correct_answer: "True"\
  \},\
  \{\
    question_text: "A Driver's Permit requires you to pass both a written and road test.",\
    correct_answer: "True"\
  \},\
  \{\
    question_text: "Once you have a Driver's Permit, you can drive any vehicle without restriction.",\
    correct_answer: "False"\
  \},\
  \{\
    question_text: "You need a valid Driver's Permit to drive on highways.",\
    correct_answer: "True"\
  \}\
];\
\
// Quiz questions (True/False)\
const quizQuestions = [\
  \{\
    question_text: "A Learner's Permit allows you to drive with a licensed adult in the car.",\
    correct_answer: "True"\
  \},\
  \{\
    question_text: "You can drive at night with a Learner's Permit without restrictions in all states.",\
    correct_answer: "False"\
  \},\
  \{\
    question_text: "A Driver's Permit allows you to drive on highways without restrictions.",\
    correct_answer: "True"\
  \},\
  \{\
    question_text: "A Driver's Permit requires you to pass a road test only.",\
    correct_answer: "False"\
  \},\
  \{\
    question_text: "It is illegal to drink alcohol while driving with a Learner's Permit.",\
    correct_answer: "True"\
  \}\
];\
\
let currentQuestionIndex = 0;\
let score = 0;\
\
function showLearnersPermit() \{\
  const learnersSection = document.getElementById("learners-permit-section");\
  const driversSection = document.getElementById("drivers-permit-section");\
\
  // Hide Driver's Permit section and show Learner's Permit section\
  driversSection.style.display = "none";\
  learnersSection.style.display = "block";\
\
  // Inject Learner's Permit questions into the section\
  const learnersPermitContainer = document.getElementById("learners-permit-questions");\
  learnersPermitContainer.innerHTML = "";\
  learnersQuestions.forEach((question, index) => \{\
    learnersPermitContainer.innerHTML += `\
      <p><strong>Question $\{index + 1\}: </strong>$\{question.question_text\}</p>\
      <p><span>Answer: </span>$\{question.correct_answer\}</p>\
    `;\
  \});\
\}\
\
function showDriversPermit() \{\
  const learnersSection = document.getElementById("learners-permit-section");\
  const driversSection = document.getElementById("drivers-permit-section");\
\
  // Hide Learner's Permit section and show Driver's Permit section\
  learnersSection.style.display = "none";\
  driversSection.style.display = "block";\
\
  // Inject Driver's Permit questions into the section\
  const driversPermitContainer = document.getElementById("drivers-permit-questions");\
  driversPermitContainer.innerHTML = "";\
  driversQuestions.forEach((question, index) => \{\
    driversPermitContainer.innerHTML += `\
      <p><strong>Question $\{index + 1\}: </strong>$\{question.question_text\}</p>\
      <p><span>Answer: </span>$\{question.correct_answer\}</p>\
    `;\
  \});\
\}\
\
function startQuiz() \{\
  const quizSection = document.getElementById("quiz-section");\
  const learnersSection = document.getElementById("learners-permit-section");\
  const driversSection = document.getElementById("drivers-permit-section");\
  const categorySection = document.getElementById("category");\
\
  // Hide other sections and show the quiz section\
  categorySection.style.display = "none";\
  learnersSection.style.display = "none";\
  driversSection.style.display = "none";\
  quizSection.style.display = "block";\
\
  // Inject quiz questions\
  const quizContainer = document.getElementById("quiz-questions");\
  quizContainer.innerHTML = "";\
  quizQuestions.forEach((question, index) => \{\
    quizContainer.innerHTML += `\
      <p><strong>Question $\{index + 1\}: </strong>$\{question.question_text\}</p>\
      <label><input type="radio" name="q$\{index\}" value="True"> True</label>\
      <label><input type="radio" name="q$\{index\}" value="False"> False</label>\
    `;\
  \});\
\}\
\
function submitQuiz() \{\
  score = 0;\
\
  // Check answers\
  quizQuestions.forEach((question, index) => \{\
    const selectedOption = document.querySelector(`input[name="q$\{index\}"]:checked`);\
    if (selectedOption && selectedOption.value === question.correct_answer) \{\
      score++;\
    \}\
  \});\
\
  // Show results\
  showResults();\
\}\
\
function showResults() \{\
  const quizSection = document.getElementById("quiz-section");\
  const resultsSection = document.getElementById("results-section");\
\
  // Hide the quiz section and show the results section\
  quizSection.style.display = "none";\
  resultsSection.style.display = "block";\
\
  // Display results\
  const resultText = document.getElementById("result-text");\
  resultText.textContent = `You scored $\{score\} out of $\{quizQuestions.length\}`;\
\}\
\
function restartQuiz() \{\
  // Restart quiz logic\
  score = 0;\
  currentQuestionIndex = 0;\
  startQuiz();\
\}\
\
function goBack() \{\
  // Show category selection and hide other sections\
  document.getElementById("category").style.display = "block";\
  document.getElementById("learners-permit-section").style.display = "none";\
  document.getElementById("drivers-permit-section").style.display = "none";\
  document.getElementById("quiz-section").style.display = "none";\
  document.getElementById("results-section").style.display = "none";\
\}}